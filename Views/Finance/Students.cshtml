@model StudentFoodParcelApp.Models.FinanceStudentsViewModel

@{
    ViewData["Title"] = "Student Verification";
}

<!-- Hidden Form to Render Anti-Forgery Token for AJAX -->
<form id="afForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">Student Funding Verification</h3>
        <p class="text-muted small mb-0">Select a food parcel cycle to verify applicants' funding statuses.</p>
    </div>
</div>

<!-- Cycle Selection -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="card-body p-4">
        <form method="get" asp-action="Students" class="row align-items-end">
            <div class="col-md-6 mb-3 mb-md-0">
                <label class="form-label fw-bold text-dark">Select Application Cycle</label>
                <select name="cycleId" class="form-select form-select-lg" onchange="this.form.submit()">
                    <option value="">-- Choose a Cycle to Verify --</option>
                    @foreach (var cycle in Model.AvailableCycles)
                    {
                        <option value="@cycle.Value" selected="@(Model.SelectedCycleId?.ToString() == cycle.Value)">@cycle.Text</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedCycleId.HasValue)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <button id="btnEditPage" class="btn btn-outline-primary px-3 fw-semibold">
                <i class="bi bi-pencil-square me-1"></i> Edit Verification
            </button>
            <button id="btnSavePage" class="btn btn-success px-3 fw-semibold d-none">
                <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
            <button id="btnCancelPage" class="btn btn-secondary px-3 fw-semibold d-none" onclick="window.location.reload();">
                <i class="bi bi-x-lg me-1"></i> Cancel Changes
            </button>
        </div>
        <div>
            <a asp-action="DownloadStudentList" asp-route-cycleId="@Model.SelectedCycleId" class="btn btn-outline-secondary px-3 fw-semibold">
                <i class="bi bi-download me-1"></i> Download CSV for this Cycle
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="studentsTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Student #</th>
                            <th>Full Name</th>
                            <th>Funding Status</th>
                            <th>Reason / Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Students.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No students have applied for this cycle.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var student in Model.Students)
                            {
                                <tr class="student-row" data-student-id="@student.StudentId">
                                    <td class="ps-3 fw-bold">@student.StudentNumber</td>
                                    <td class="fw-semibold">@student.StudentName</td>
                                    <td>
                                        <select class="form-select form-select-sm funding-status-select" disabled>
                                            <!option value="UNFUNDED" @(!student.IsFunded ? "selected" : "")>UNFUNDED</!option>
                                            <!option value="FUNDED" @(student.IsFunded ? "selected" : "")>FUNDED</!option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm reason-input" 
                                               value="@student.Reason" placeholder="Enter reason / bursary notes..." readonly />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 bg-white p-5 text-center text-muted">
        <i class="bi bi-people fs-1 text-secondary mb-3"></i>
        <h5>Please select a cycle above</h5>
        <p class="small mb-0">You will only see students who have applied for the selected cycle.</p>
    </div>
}

@section Scripts {
    <script>
        function getCsrfToken() {
            const tokenElem = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            return tokenElem ? tokenElem.value : '';
        }

        const btnEdit = document.getElementById('btnEditPage');
        const btnSave = document.getElementById('btnSavePage');
        const btnCancel = document.getElementById('btnCancelPage');

        if (btnEdit) {
            btnEdit.addEventListener('click', function () {
                document.querySelectorAll('.funding-status-select').forEach(select => select.removeAttribute('disabled'));
                document.querySelectorAll('.reason-input').forEach(inp => inp.removeAttribute('readonly'));
                btnEdit.classList.add('d-none');
                btnSave.classList.remove('d-none');
                btnCancel.classList.remove('d-none');
            });
        }

        if (btnSave) {
            btnSave.addEventListener('click', function () {
                const updates = [];
                document.querySelectorAll('#studentsTable tbody tr.student-row').forEach(row => {
                    const studentIdAttr = row.getAttribute('data-student-id');
                    if (!studentIdAttr) return;

                    const studentId = parseInt(studentIdAttr);
                    const statusVal = row.querySelector('.funding-status-select').value;
                    const isFunded = statusVal === 'FUNDED';
                    const reason = row.querySelector('.reason-input').value;

                    updates.push({ studentId, isFunded, reason });
                });

                // Disable button during processing
                btnSave.disabled = true;
                btnSave.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

                fetch('/Finance/SaveFundingChanges', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(updates)
                })
                .then(res => {
                    if (!res.ok) throw new Error(`HTTP Error ${res.status}`);
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert('Error: ' + data.message);
                        btnSave.disabled = false;
                        btnSave.innerHTML = '<i class="bi bi-check-lg me-1"></i> Save Changes';
                    }
                })
                .catch(err => {
                    alert('Failed to save changes: ' + err.message);
                    btnSave.disabled = false;
                    btnSave.innerHTML = '<i class="bi bi-check-lg me-1"></i> Save Changes';
                });
            });
        }
    </script>
}