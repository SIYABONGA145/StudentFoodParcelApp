@{
    ViewData["Title"] = "Finance Dashboard";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1">Finance Dashboard</h3>
    <p class="text-muted small mb-0">Overview of student funding statuses and distribution eligibility across campuses.</p>
</div>

<!-- Notification Alert -->
@if (ViewBag.UnreadNotifications != null && ViewBag.UnreadNotifications > 0)
{
    <div class="alert alert-warning border-warning d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="bi bi-bell-fill fs-3 me-3 text-warning"></i>
        <div class="flex-grow-1">
            <h6 class="alert-heading fw-bold mb-1">Verification Required!</h6>
            <p class="mb-0 small">You have <strong>@ViewBag.UnreadNotifications</strong> new student applications waiting for funding verification.</p>
        </div>
        <a asp-action="Notifications" class="btn btn-warning fw-semibold ms-3 shadow-sm">
            <i class="bi bi-bell me-1"></i> View Notifications
        </a>
    </div>
}

<!-- Summary Metric Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Students</span>
                    <h2 class="fw-bold text-dark mb-0 mt-1">@ViewBag.TotalStudents</h2>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Funded (Ineligible)</span>
                    <h2 class="fw-bold text-danger mb-0 mt-1">@ViewBag.FundedCount</h2>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                    <i class="bi bi-shield-x fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Unfunded (Eligible)</span>
                    <h2 class="fw-bold text-success mb-0 mt-1">@ViewBag.UnfundedCount</h2>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pending Verification</span>
                    <h2 class="fw-bold text-warning mb-0 mt-1">@ViewBag.UnverifiedCount</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Card -->
<div class="card border-0 shadow-sm rounded-3 bg-white p-4">
    <h5 class="fw-bold text-dark mb-3">Funding Verification Quick Actions</h5>
    <p class="text-muted small">Select a distribution cycle to view applicants, verify NSFAS / bursary status, and export official lists for SRC parcel distribution review.</p>
    <div class="d-flex gap-3 mt-2">
        <a asp-controller="Finance" asp-action="Students" class="btn btn-primary px-4 fw-semibold shadow-sm">
            <i class="bi bi-person-check me-2"></i>Verify Cycle Applicants
        </a>
    </div>
</div>