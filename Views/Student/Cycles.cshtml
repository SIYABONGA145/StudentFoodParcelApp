@model IEnumerable<StudentFoodParcelApp.Models.ParcelCycleViewModel>

@{
    ViewData["Title"] = "Open Parcel Cycles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Food Parcel Cycles</h3>
        <p class="text-muted small mb-0">Browse active distribution cycles and apply for your parcel.</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary"></i>
            <p class="mb-0 fw-semibold">No active parcel cycles available at the moment.</p>
            <small>Please check back later for newly scheduled distribution cycles.</small>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var cycle in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-3">
                    <div class="card-header bg-dark text-white p-3 border-0 rounded-top-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">@cycle.CycleName</h5>
                            <span class="badge bg-success">ACTIVE</span>
                        </div>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-calendar-event me-1 text-primary"></i><strong>Duration:</strong> @cycle.StartDate - @cycle.EndDate
                            </p>
                            
                            <h6 class="fw-bold text-dark mb-2">Included Items:</h6>
                            @if (cycle.Items == null || !cycle.Items.Any())
                            {
                                <p class="text-muted small fst-italic">Standard parcel contents apply.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush small mb-3">
                                    @foreach (var item in cycle.Items)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 bg-transparent border-bottom">
                                            <span><i class="bi bi-check2 text-success me-2"></i>@item.ItemName</span>
                                            <span class="badge bg-secondary rounded-pill">x@(item.Quantity)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="pt-2 border-top mt-auto">
                            <a asp-controller="Student" asp-action="Applications" asp-route-cycleId="@cycle.CycleId" class="btn btn-primary w-100 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i>Apply for this Cycle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}