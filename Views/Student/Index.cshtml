@model StudentFoodParcelApp.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Welcome back, @Model.StudentName</h3>
        <p class="text-muted small mb-0">
            @Model.StudentNumber &middot; @Model.CampusName &middot;
            You have <strong>@Model.UnreadNotifications</strong> unread notification(s).
        </p>
    </div>
    <a asp-action="Applications" asp-route-openModal="true" class="btn btn-primary px-4 fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>New Application
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                    <i class="bi bi-file-earmark-text fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalApplications</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 me-3">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Pending</div>
                    <div class="fs-3 fw-bold text-dark">@Model.PendingCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-success-subtle text-success p-3 me-3">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Approved</div>
                    <div class="fs-3 fw-bold text-dark">@Model.ApprovedCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info-subtle text-info p-3 me-3">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Collected</div>
                    <div class="fs-3 fw-bold text-dark">@Model.CollectedCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Recent Applications</h6>
                <a asp-action="Applications" class="small text-decoration-none fw-semibold">
                    View all &rarr;
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentApplications == null || !Model.RecentApplications.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-1 fw-semibold">No applications yet.</p>
                        <small>Click <em>New Application</em> to submit your first food parcel request.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Reference</th>
                                    <th>Parcel Cycle</th>
                                    <th>Date Requested</th>
                                    <th class="pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.RecentApplications)
                                {
                                    var badge = app.CurrentStatus switch
                                    {
                                        "APPROVED" or "COLLECTED" => "success",
                                        "REJECTED" or "WITHDRAWN" => "danger",
                                        _                          => "warning"
                                    };
                                    <tr>
                                        <td class="ps-3 fw-bold">@app.ReferenceNumber</td>
                                        <td class="fw-semibold">@app.CycleName</td>
                                        <td>@app.RequestDate</td>
                                        <td class="pe-3">
                                            <span class="badge bg-@badge text-uppercase">@app.CurrentStatus</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-qr-code-scan me-2"></i>Next Collection</h6>
            </div>
            <div class="card-body">
                @if (Model.NextCollection == null)
                {
                    <p class="text-muted small mb-0">
                        No approved parcel awaiting collection. Approved requests will appear here.
                    </p>
                }
                else
                {
                    <p class="mb-1 small text-muted">Reference</p>
                    <p class="fw-bold mb-2">@Model.NextCollection.VerificationToken</p>

                    <p class="mb-1 small text-muted">Cycle</p>
                    <p class="fw-semibold mb-2">@Model.NextCollection.CycleName</p>

                    <p class="mb-1 small text-muted">Venue</p>
                    <p class="fw-semibold mb-2">@Model.NextCollection.VenueName</p>

                    <p class="mb-1 small text-muted">Date &amp; Time</p>
                    <p class="fw-semibold mb-3">
                        @Model.NextCollection.DistributionDate &middot; @Model.NextCollection.DistributionTime
                    </p>

                    <a asp-action="Collections" class="btn btn-success w-100 fw-semibold">
                        <i class="bi bi-qr-code me-1"></i>View QR Pass
                    </a>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0">Quick Actions</h6>
            </div>
            <div class="list-group list-group-flush">
                <a asp-action="Applications" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                    <i class="bi bi-file-earmark-plus text-primary me-3 fs-5"></i>
                    <span class="fw-semibold">Manage Applications</span>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>
                <a asp-action="Cycles" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                    <i class="bi bi-calendar-event text-success me-3 fs-5"></i>
                    <span class="fw-semibold">Browse Open Cycles</span>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>
                <a asp-action="Collections" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                    <i class="bi bi-qr-code-scan text-info me-3 fs-5"></i>
                    <span class="fw-semibold">Collection Passes</span>
                    <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                </a>
                <a asp-action="Notifications" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                    <i class="bi bi-bell text-warning me-3 fs-5"></i>
                    <span class="fw-semibold">Notifications</span>
                    @if (Model.UnreadNotifications > 0)
                    {
                        <span class="badge bg-danger ms-auto">@Model.UnreadNotifications</span>
                    }
                    else
                    {
                        <i class="bi bi-chevron-right ms-auto text-muted small"></i>
                    }
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.ActiveCycles != null && Model.ActiveCycles.Any())
{
    <div class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Open Parcel Cycles</h6>
            <a asp-action="Cycles" class="small text-decoration-none fw-semibold">
                View all &rarr;
            </a>
        </div>
        <div class="row g-3">
            @foreach (var cycle in Model.ActiveCycles)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">@cycle.CycleName</h6>
                                <span class="badge bg-success">OPEN</span>
                            </div>
                            <p class="small text-muted mb-3">
                                <i class="bi bi-calendar-event me-1"></i>
                                @cycle.StartDate – @cycle.EndDate
                            </p>

                            @if (cycle.Items != null && cycle.Items.Any())
                            {
                                <ul class="list-unstyled small mb-3">
                                    @foreach (var item in cycle.Items.Take(3))
                                    {
                                        <li class="mb-1">
                                            <i class="bi bi-check2 text-success me-1"></i>
                                            @item.ItemName <span class="text-muted">(x@item.Quantity)</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="small fst-italic text-muted mb-3">Standard parcel contents apply.</p>
                            }

                            <a asp-action="Applications" asp-route-cycleId="@cycle.CycleId"
                               class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i>Apply
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}