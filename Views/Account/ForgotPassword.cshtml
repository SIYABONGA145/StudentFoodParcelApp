@model StudentFoodParcelApp.Models.ForgotPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="card shadow-sm col-md-5 col-lg-4 mx-auto">
    <div class="card-header bg-warning text-dark text-center py-3">
        <h4 class="mb-0 fs-5"><i class="bi bi-key-fill me-2"></i>Forgot Password</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <div class="mb-3">
                <label asp-for="EmailAddress" class="form-label fw-semibold"></label>
                <input asp-for="EmailAddress" class="form-control" placeholder="Enter your registered email" />
                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-warning w-100 mb-2 py-2 fw-semibold">Continue</button>
            <a asp-action="Login" class="btn btn-link w-100 text-center text-decoration-none small">Back to Login</a>
        </form>
    </div>
</div>