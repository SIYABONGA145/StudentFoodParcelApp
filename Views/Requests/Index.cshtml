@model IEnumerable<StudentFoodParcelApp.Models.VwStudentRequest>

@{
    ViewData["Title"] = "My Applications";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1">My Applications</h2>
            <p class="text-muted small mb-0">Apply for ongoing food parcel distribution cycles and monitor your approval status.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 fw-semibold">+ New Application</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Req ID</th>
                        <th scope="col">Parcel Cycle</th>
                        <th scope="col">Date Requested</th>
                        <th scope="col">Application Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@req.Requestid</td>
                                <td>@req.CycleApplyingFor</td>
                                <td>@req.RequestDate</td>
                                <td>
                                    @if (req.FundingStatus?.ToUpper() == "APPROVED")
                                    {
                                        <span class="badge bg-success px-2 py-1">APPROVED</span>
                                    }
                                    else if (req.FundingStatus?.ToUpper() == "REJECTED")
                                    {
                                        <span class="badge bg-danger px-2 py-1">REJECTED</span>
                                    }
                                    else if (req.FundingStatus?.ToUpper() == "EXPIRED")
                                    {
                                        <span class="badge bg-secondary px-2 py-1">EXPIRED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">PENDING</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No applications submitted yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>