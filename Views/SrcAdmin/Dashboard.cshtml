@model StudentFoodParcelApp.Models.SrcAdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_SrcAdminLayout.cshtml";
    ViewData["Title"] = "SRC Admin Dashboard";

    var dashboardModel = Model ?? new StudentFoodParcelApp.Models.SrcAdminDashboardViewModel
    {
        AdminName = User.Identity?.Name ?? "SRC Administrator",
        CampusName = "Main Campus",
        TotalApplications = ViewBag.TotalApplications ?? 0,
        PendingCount = ViewBag.PendingCount ?? 0,
        ApprovedCount = ViewBag.ApprovedCount ?? 0,
        RejectedCount = ViewBag.RejectedCount ?? 0
    };
}

<style>
    .metric-card { border: none; border-radius: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease; position: relative; overflow: hidden; }
    .metric-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08) !important; }
    .metric-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
    .metric-card-primary::before { background-color: #2563eb; }
    .metric-card-warning::before { background-color: #f59e0b; }
    .metric-card-success::before { background-color: #10b981; }
    .metric-card-danger::before { background-color: #ef4444; }
    .icon-box { width: 52px; height: 52px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .quick-action-btn { border-radius: 10px; transition: all 0.2s ease-in-out; }
    .quick-action-btn:hover { transform: translateY(-2px); }
    .badge-pending   { background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .badge-approved  { background-color: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .badge-rejected  { background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .badge-collected { background-color: #e0e7ff; color: #3730a3; border: 1px solid #a5b4fc; }
</style>

<!-- 1. Welcome Section Header -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4 p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1 rounded-2 small">
                    <i class="bi bi-building me-1"></i>@(dashboardModel.CampusName ?? "Main") Campus
                </span>
            </div>
            <h3 class="fw-bold text-dark mb-1">
                Welcome back, @(dashboardModel.AdminName ?? "SRC Administrator")
            </h3>
            <p class="text-muted small mb-0">
                Manage student food parcel allocation, review submitted requests, and coordinate pickup schedules.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="SrcAdmin" asp-action="Applications" class="btn btn-primary px-3 py-2 fw-semibold rounded-3 shadow-sm">
                <i class="bi bi-file-earmark-check me-1.5"></i>Manage Applications
            </a>
            <a asp-controller="SrcAdmin" asp-action="Cycles" class="btn btn-outline-secondary px-3 py-2 fw-semibold rounded-3">
                <i class="bi bi-box-seam me-1.5"></i>Parcel Cycles
            </a>
        </div>
    </div>
</div>

<!-- 2. Enhanced Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card metric-card metric-card-primary shadow-sm bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Total Applications</span>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@(ViewBag.TotalApplications ?? dashboardModel.TotalApplications)</h2>
                </div>
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-folder2-open fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card metric-card metric-card-warning shadow-sm bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Pending Review</span>
                    <h2 class="fw-bold text-warning mt-2 mb-0">@(ViewBag.PendingCount ?? dashboardModel.PendingCount)</h2>
                </div>
                <div class="icon-box bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card metric-card metric-card-success shadow-sm bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Approved</span>
                    <h2 class="fw-bold text-success mt-2 mb-0">@(ViewBag.ApprovedCount ?? dashboardModel.ApprovedCount)</h2>
                </div>
                <div class="icon-box bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card metric-card metric-card-danger shadow-sm bg-white p-3 h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase tracking-wider">Rejected</span>
                    <h2 class="fw-bold text-danger mt-2 mb-0">@(ViewBag.RejectedCount ?? dashboardModel.RejectedCount)</h2>
                </div>
                <div class="icon-box bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-x-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions Shortcuts -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="SrcAdmin" asp-action="Applications" class="card border-0 shadow-sm p-3 bg-white text-decoration-none quick-action-btn">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary"><i class="bi bi-clipboard-check fs-4"></i></div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Review Applications</h6>
                    <small class="text-muted">Process pending student submissions</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="SrcAdmin" asp-action="Distributions" class="card border-0 shadow-sm p-3 bg-white text-decoration-none quick-action-btn">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-info bg-opacity-10 text-info"><i class="bi bi-calendar-event fs-4"></i></div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Schedule Collections</h6>
                    <small class="text-muted">Set distribution dates & venues</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="SrcAdmin" asp-action="Cycles" class="card border-0 shadow-sm p-3 bg-white text-decoration-none quick-action-btn">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-success bg-opacity-10 text-success"><i class="bi bi-box-seam fs-4"></i></div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Manage Cycles</h6>
                    <small class="text-muted">Create food parcel packages</small>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Applications Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-dark mb-0">Recent Student Applications</h5>
                    <small class="text-muted">Latest submissions requiring administrative action</small>
                </div>
                <a asp-controller="SrcAdmin" asp-action="Applications" class="btn btn-sm btn-light text-primary fw-semibold">
                    View All &rarr;
                </a>
            </div>
            <div class="card-body px-0 pt-3">
                @if (dashboardModel.RecentApplications == null || !dashboardModel.RecentApplications.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-0 fw-semibold">No recent applications submitted.</p>
                        <small>New food parcel requests will appear here dynamically.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small fw-bold text-uppercase">
                                <tr>
                                    <th class="ps-4">Student</th>
                                    <th>Cycle</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in dashboardModel.RecentApplications)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold text-dark">@item.StudentName</div>
                                            <small class="text-muted">@item.StudentNumber</small>
                                        </td>
                                        <td><span class="small text-dark">@item.CycleName</span></td>
                                        <td><small class="text-muted">@item.RequestDate</small></td>
                                        <td>
                                            @{
                                                var status = item.CurrentStatus ?? "";
                                                if (status.Equals("APPROVED", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge badge-approved rounded-pill px-2.5 py-1 font-monospace small">
                                                        <i class="bi bi-check-circle me-1"></i>APPROVED
                                                    </span>
                                                }
                                                else if (status.Equals("COLLECTED", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge badge-collected rounded-pill px-2.5 py-1 font-monospace small">
                                                        <i class="bi bi-check2-all me-1"></i>COLLECTED
                                                    </span>
                                                }
                                                else if (status.Equals("REJECTED", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge badge-rejected rounded-pill px-2.5 py-1 font-monospace small">
                                                        <i class="bi bi-x-circle me-1"></i>REJECTED
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-pending rounded-pill px-2.5 py-1 font-monospace small">
                                                        <i class="bi bi-clock me-1"></i>PENDING
                                                    </span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="SrcAdmin" asp-action="Applications" class="btn btn-sm btn-outline-primary fw-semibold rounded-2">
                                                Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Side Column: Notifications & Collection Info -->
    <div class="col-lg-4 d-flex flex-column gap-4">
        <!-- System Notifications -->
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-bell me-2 text-primary"></i>System Notifications
                </h6>
                <a asp-controller="SrcAdmin" asp-action="Notifications" class="small text-decoration-none fw-semibold">
                    View All
                </a>
            </div>
            <div class="card-body p-3">
                @if (dashboardModel.RecentNotifications == null || !dashboardModel.RecentNotifications.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-bell-slash fs-3 d-block mb-1 text-secondary"></i>
                        <small>No recent campus notifications.</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var note in dashboardModel.RecentNotifications)
                        {
                            <div class="list-group-item px-0 py-2.5 bg-transparent border-bottom">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-semibold text-dark small">@note.Title</span>
                                    <small class="text-muted ms-2" style="font-size: 0.7rem;">@note.Createddate</small>
                                </div>
                                <p class="text-muted small mb-0 lh-sm text-truncate">@note.Message</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Collection Schedule -->
        <div class="card border-0 shadow-sm rounded-3 bg-white flex-grow-1">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-geo-alt me-2 text-danger"></i>Collection Schedule
                </h6>
                <a asp-controller="SrcAdmin" asp-action="Distributions" class="small text-decoration-none fw-semibold">
                    Manage
                </a>
            </div>
            <div class="card-body p-3">
                @if (dashboardModel.ScheduledDistributions == null || !dashboardModel.ScheduledDistributions.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x fs-3 d-block mb-1 text-secondary"></i>
                        <small>No active pickup distributions scheduled.</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var dist in dashboardModel.ScheduledDistributions)
                        {
                            <div class="list-group-item px-0 py-2 bg-transparent border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark small">Student #@dist.StudentNumber</span>
                                    @{
                                        var st = dist.CurrentStatus ?? "";
                                        if (st.Equals("COLLECTED", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge badge-collected rounded-pill px-2 py-0.5 small">COLLECTED</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-approved rounded-pill px-2 py-0.5 small">READY</span>
                                        }
                                    }
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-clock me-1"></i>@dist.ScheduledDate
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>